# Paste each line as Railway Variable (name = value). Fill from your local .env.
# Do NOT commit this file after filling real secrets — keep placeholders only in git.
#
# Stable profile for document indexing with all-mpnet-base-v2 (slower, avoids OOM/502).
# Requires Railway Developer plan (~8 GB RAM). Do not raise batch sizes unless you upgrade RAM.

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
HUGGINGFACE_API_KEY=

IMAGE_EMBEDDING_MODEL=microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224
TEXT_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Chunks per enrich-chunks HTTP call (embeddings phase). 8 is safe for mpnet on ~8 GB.
ENRICH_BATCH_SIZE=8
ENRICH_METADATA_BATCH_SIZE=64
# Internal torch forward-pass size per encode_texts() call.
ENCODE_BATCH_SIZE=4

# Limit CPU thread pools — reduces memory spikes during inference.
TORCH_NUM_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
