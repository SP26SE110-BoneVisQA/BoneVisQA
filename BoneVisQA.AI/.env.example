# Copy to .env for local development (never commit .env).
# Generate from .NET User Secrets or run start_dev.bat (syncs via sync script if added).

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
HUGGINGFACE_API_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Vision encoder for case_media_embeddings (BiomedCLIP via OpenCLIP)
IMAGE_EMBEDDING_MODEL=microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224
