# Copy to .env for local development (never commit .env).
# On Railway: paste the same keys into Service → Variables (no PORT — Railway sets it).

# Postgres (Supabase pooler). Alternative name: SUPABASE_DB_URL
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=

# Hugging Face (gated models / download rate limits) — auth only, NOT a model name
HUGGINGFACE_API_KEY=

# --- Embedding models (Hugging Face repo ids: org/model — never paste your API token here) ---
IMAGE_EMBEDDING_MODEL=microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224

# Production (Railway): mpnet — higher quality, needs small batches (see below).
TEXT_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# Local dev on low RAM: uncomment MiniLM instead.
# TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Document enrich tuning (balanced: stable + moderate speed on Railway) ---
ENRICH_BATCH_SIZE=12
ENRICH_METADATA_BATCH_SIZE=64
ENCODE_BATCH_SIZE=6
# Safer fallback if OOM/502: ENRICH_BATCH_SIZE=8, ENCODE_BATCH_SIZE=4
TORCH_NUM_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
